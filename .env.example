# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
NODE_ENV=development

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD= password
DB_NAME=reusehub
# For cloud MySQL (Aiven, TiDB Cloud, etc.) set DB_SSL=true. Leave false for local MySQL.
DB_SSL=false

# Long random text used to sign session cookies (required). Example: any 32+ random characters.
SESSION_SECRET=change_this_to_a_long_random_text

# First administrator account, created by "npm run setup".
# Choose your own password (min 8 chars, letters + numbers). It is only read by the setup script.
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@reusehub.com
ADMIN_PASSWORD=admim_password_here

# Set to true to also insert demo students, sample listings and sample requests.
SEED_DEMO=true
